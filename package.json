{
  "name": "@no4mat/pi-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi TUI widgets: provider quotas and context breakdown",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.23.2"
  },
  "pi": {
    "extensions": [
      "./src/usage-bar/index.ts",
      "./src/context-breakdown/index.ts"
    ]
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit && npm test && node scripts/check-repo.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@types/node": "22.18.6",
    "typescript": "5.9.2"
  }
}
